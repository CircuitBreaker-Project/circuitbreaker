# Application Configuration
SPRING_PROFILES_ACTIVE=default

# Eureka Server Configuration
EUREKA_SERVER_HOST=eureka-server
EUREKA_SERVER_PORT=8761
EUREKA_CLIENT_REGISTER_WITH_EUREKA=false
EUREKA_CLIENT_FETCH_REGISTRY=false

# API Gateway Configuration
API_GATEWAY_HOST=api-gateway
API_GATEWAY_PORT=8080
API_GATEWAY_EUREKA_DEFAULT_ZONE=http://eureka-server:8761/eureka/

# Microservices Configuration
MICROSERVICE_1_HOST=microservice-1
MICROSERVICE_1_PORT=8081
MICROSERVICE_2_HOST=microservice-2
MICROSERVICE_2_PORT=8082

# Zipkin Configuration
ZIPKIN_HOST=zipkin
ZIPKIN_PORT=9411
ZIPKIN_BASE_URL=http://zipkin:9411

# React Dashboard Configuration
REACT_APP_API_URL=http://api-gateway:8080
REACT_APP_ZIPKIN_URL=http://zipkin:9411

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50
CIRCUIT_BREAKER_WAIT_DURATION_IN_OPEN_STATE=10s
CIRCUIT_BREAKER_SLIDING_WINDOW_SIZE=10
CIRCUIT_BREAKER_MINIMUM_NUMBER_OF_CALLS=5
CIRCUIT_BREAKER_PERMITTED_NUMBER_OF_CALLS_IN_HALF_OPEN_STATE=3

# Tracing Configuration
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0

# Docker Configuration
COMPOSE_PROJECT_NAME=circuit-breaker
DOCKER_NETWORK_NAME=circuit-breaker-network
